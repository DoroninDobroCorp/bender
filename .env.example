# ═══════════════════════════════════════════════════════════
# Bender Configuration
# ═══════════════════════════════════════════════════════════

# Primary LLM: Cerebras (GLM)
GLM_API_KEY=your-cerebras-api-key
# GLM_API_KEYS=key1,key2,key3  # Multiple keys for rotation

# Fallback LLM: Google Gemini
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key1,key2,key3  # Multiple keys for rotation

# Project path (where your code lives)
DROID_PROJECT_PATH=/path/to/your/project

# Display mode: visible | silent
DISPLAY_MODE=visible

# Auto git push after task completion
AUTO_GIT_PUSH=true

# Escalation threshold (review iterations before escalating)
BENDER_ESCALATE_AFTER=5

# Watchdog settings (seconds)
WATCHDOG_INTERVAL=300
WATCHDOG_TIMEOUT=3600

# LLM settings
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
LLM_REQUESTS_PER_MINUTE=60
